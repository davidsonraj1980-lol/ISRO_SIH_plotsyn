# ISRO Netra-Vision Backend Configuration
PORT=8000
ENVIRONMENT=production

# Option 1: Groq Vision API (Ultra-fast Llama-3.2-11b-vision)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.2-11b-vision-preview

# Option 2: OpenRouter Multimodal API (Qwen2-VL / Llama-3.2-Vision)
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
OPENROUTER_MODEL=meta-llama/llama-3.2-11b-vision-instruct
